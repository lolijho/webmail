# Porta del server (default 3000)
PORT=3000

# Imposta a "production" per attivare i cookie sicuri (solo HTTPS)
NODE_ENV=development

# ---- Invio via Resend (consigliato su Coolify/VPS) ----
# Se il tuo host blocca le porte SMTP in uscita (25/465/587), configura Resend:
# l'invio avviene via API HTTPS (porta 443), che non viene mai bloccata.
# Crea una API key su https://resend.com/api-keys
RESEND_API_KEY=

# Indirizzo mittente usato da Resend. DEVE essere su un dominio verificato nel
# tuo account Resend (https://resend.com/domains). Es: "Nome <info@tuodominio.com>"
# Se vuoto, viene usato l'indirizzo con cui accedi.
MAIL_FROM=
