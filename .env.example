# Porta del server (default 3000)
PORT=3000

# Imposta a "production" per attivare i cookie sicuri (solo HTTPS)
NODE_ENV=development

# ---- Sicurezza ----
# Chiave per cifrare i segreti salvati (password IMAP, chiavi Resend).
# Generala con: openssl rand -base64 32
# Se vuota, ne viene generata una e salvata in DATA_DIR/.encryption-key
# (fai il backup di quel file, altrimenti i dati cifrati diventano illeggibili).
ENCRYPTION_KEY=

# Cartella dati (database SQLite + chiave di cifratura). Su Coolify montaci un volume.
DATA_DIR=./data

# Metti "false" per chiudere le registrazioni dopo aver creato i tuoi utenti.
REGISTRATION_OPEN=true

# ---- Invio via Resend (consigliato su Coolify/VPS) ----
# Chiave Resend usata come default per tutti gli utenti (ognuno può comunque
# inserire la propria nelle impostazioni). L'invio avviene via API HTTPS (443),
# quindi funziona anche se l'host blocca le porte SMTP in uscita.
# Crea una API key su https://resend.com/api-keys
# NB: si può inviare solo da domini verificati su https://resend.com/domains
RESEND_API_KEY=
